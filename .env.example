# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Monad Blockchain Network Configuration
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_GRANT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
MONAD_PRIVATE_KEY=your_monad_testnet_private_key_here

# AI Provider API Configuration (Server-side key, never exposed to browser)
# Supports Kimi (Moonshot), Qwen (DashScope), Gemini OpenAI-compat, or standard OpenAI API
AI_API_KEY=your_llm_api_key_here
AI_PROVIDER_URL=https://api.moonshot.cn/v1
AI_MODEL_NAME=moonshot-v1-8k
